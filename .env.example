# ---- Django ----
SECRET_KEY=change-me-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development

# ---- Database (PostgreSQL for production, SQLite fallback for dev) ----
# Example: postgres://user:password@localhost:5432/marage_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marage_db

# ---- Domain ----
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://marriagesupport.gov.ae
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---- Celery / Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Superuser seed ----
ADMIN_EMAIL=admin@maragesupport.ae
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_PASSWORD=admin12345

# ---- Sentry (optional) ----
SENTRY_DSN=

# ---- Stripe ----
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=aed
# How long a pending (unpaid) booking holds a seat before the scheduled job releases it (seconds).
BOOKING_PENDING_TTL_SECONDS=1200
# Optional path to a static copy of the Apple Pay domain verification file.
APPLE_PAY_DOMAIN_ASSOCIATION_FILE=